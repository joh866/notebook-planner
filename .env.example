# Copy this file to a new file named .env and fill in the values.
# .env is ignored by git, so your key never gets committed. Never share it.

# Create a key at platform.claude.com, under Settings, then API keys.
ANTHROPIC_API_KEY=

# The model the add box uses. claude-haiku-4-5-20251001 is cheaper and faster,
# if its sorting turns out to be good enough.
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Online (step 14, DEPLOY.md) ----

# Sign-in. Don't type these yourself: run `npm run set-password` on the droplet, which writes both.
# Leave them out on your Mac and localhost stays open with no sign-in.
AUTH_PASSWORD_HASH=
SESSION_SECRET=

# On the droplet: where the nightly backup goes, as an rclone remote and bucket.
BACKUP_REMOTE=offsite:your-bucket-name

# On your Mac: where `npm run deploy` sends the app.
DEPLOY_HOST=planner@planner.yourdomain.com

# Notifications (step 15). Don't type these: `npm run push-keys` writes them, and `npm run deploy`
# runs it on the droplet. The public key goes to the browser; the private key never leaves the server.
# Leave them out on your Mac and notifications stay off there.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://planner.yourdomain.com

# Google Calendar (step 16). The steps to get these are in GOOGLE.md. The secret stays on the server.
# Leave them out and Settings says Google Calendar isn't set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# On the droplet: https://planner.yourdomain.com/api/google/callback. On your Mac it's worked out on its own.
GOOGLE_REDIRECT_URI=
